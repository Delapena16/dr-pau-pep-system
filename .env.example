# ============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to ".env" before running the server: cp .env.example .env
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/dr_pau_pep_db

# JWT Security Configuration (Modules 05, 06 & 13 Compliance)
# Use a long, cryptographically random secret string in production
JWT_SECRET=dr_pau_pep_super_secret_jwt_signing_key_2026_capstone_defense
JWT_EXPIRES_IN=8h

# Frontend Origin for CORS policy
CLIENT_ORIGIN=http://localhost:5000
